      "TrendsInterestResponse": {
        "description": "Relative search-interest series returned by ``GET /api/trends/interest``.\n\nValues are Google's 0-100 index scaled jointly across all requested\nkeywords within the window; they are never absolute search counts.\n``is_partial`` aligns with ``dates`` and flags still-accumulating periods.",
        "properties": {
          "dates": {
            "items": {
              "type": "string"
            },
            "title": "Dates",
            "type": "array"
          },
          "fetched_at": {
            "title": "Fetched At",
            "type": "string"
          },
          "geo": {
            "title": "Geo",
            "type": "string"
          },
          "is_partial": {
            "items": {
              "type": "boolean"
