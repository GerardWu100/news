# Browser and command-line sign-in accounts. At least one complete account is
# required before the server will answer any request. On startup the server
# hashes each password, verifies the hash, and stores only the hash in
# .ui_credentials.json. You never run a hashing command yourself.
# Changing, adding, or removing an account signs out every remembered browser
# on the next restart.

# Account name typed into the sign-in form.
UI_USERNAME=admin

# Plain-text password. Change this before exposing the server.
UI_PASSWORD=changeme

# Optional second and third accounts. Every account has the same access; they
# exist to give separate people separate passwords. Leave a slot blank to skip
# it, set both values to use it, and keep the account names different.
UI_USERNAME_2=
UI_PASSWORD_2=
UI_USERNAME_3=
UI_PASSWORD_3=

# Base URL used by news-search when --server is omitted.
# Keep the local default or replace it with a private remote deployment URL.
NEWS_SERVER_URL=http://localhost:8000

# Docker only. The container serves as an unprivileged account, so it must run
# as the owner of ${HOME}/.containers/news to write there. Set these to your
# own values, which 'id -u' and 'id -g' report.
NEWS_UID=1000
NEWS_GID=1000

# New York Times Article Search API credentials.
# The current source adapter uses only NYT_API_KEY.
NYT_API_KEY=your_nyt_api_key
NYT_API_SECRET=your_nyt_api_secret

# MediaCloud Search API key.
MEDIACLOUD_API_KEY=your_mediacloud_api_key

# NewsAPI key.
NEWSAPI_API_KEY=your_newsapi_api_key

# Guardian Open Platform API key.
GUARDIAN_API_KEY=your_guardian_api_key

# ACLED OAuth login settings.
ACLED_OAUTH_TOKEN_URL=https://acleddata.com/oauth/token
ACLED_OAUTH_GRANT_TYPE=password
ACLED_OAUTH_CLIENT_ID=acled
ACLED_USERNAME=your_acled_email
ACLED_PASSWORD=your_acled_password

# ACLED bearer fields are generated by scripts/acled_oauth_token.py.
ACLED_BEARER_TOKEN=
ACLED_BEARER_TOKEN_TYPE=Bearer
ACLED_BEARER_EXPIRES_IN=
ACLED_REFRESH_TOKEN=
ACLED_BEARER_OBTAINED_AT_UTC=
